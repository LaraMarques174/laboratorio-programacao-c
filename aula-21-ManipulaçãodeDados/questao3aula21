#include <stdio.h>
#include <string.h>

typedef struct {
    char nome[50];
    float salario;
    int horasExtras;
} Funcionario;

void cadastrar() {
    FILE *arquivo;
    Funcionario f;
    int qtd, i;

    arquivo = fopen("funcionarios.txt", "a");   // "a" = acrescenta sem apagar
    if (arquivo == NULL) {
        printf("Erro ao abrir o arquivo!\n");
        return;
    }

    do {
        printf("Quantos funcionarios deseja cadastrar (1 a 5)? ");
        scanf("%d", &qtd);
        getchar();
    } while (qtd < 1 || qtd > 5);

    for (i = 0; i < qtd; i++) {
        printf("\nFuncionario %d\n", i + 1);

        printf("Nome: ");
        fgets(f.nome, sizeof(f.nome), stdin);
        f.nome[strcspn(f.nome, "\n")] = '\0';

        printf("Salario: ");
        scanf("%f", &f.salario);

        printf("Horas extras: ");
        scanf("%d", &f.horasExtras);
        getchar();

        fprintf(arquivo, "%s;%.2f;%d\n", f.nome, f.salario, f.horasExtras);
    }

    fclose(arquivo);
    printf("\nDados gravados com sucesso!\n");
}

void listar() {
    FILE *arquivo;
    Funcionario f;

    arquivo = fopen("funcionarios.txt", "r");
    if (arquivo == NULL) {
        printf("\nNenhum funcionario cadastrado ainda.\n");
        return;
    }

    printf("\n===== FUNCIONARIOS CADASTRADOS =====\n");
    while (fscanf(arquivo, " %49[^;];%f;%d", f.nome, &f.salario, &f.horasExtras) == 3) {
        printf("\nNome: %s\n", f.nome);
        printf("Salario: R$ %.2f\n", f.salario);
        printf("Horas extras: %d\n", f.horasExtras);
    }

    fclose(arquivo);
}

int main() {
    int opcao;

    do {
        printf("\n===== MENU =====\n");
        printf("1 - Cadastrar funcionarios\n");
        printf("2 - Listar funcionarios\n");
        printf("0 - Sair\n");
        printf("Escolha uma opcao: ");
        scanf("%d", &opcao);
        getchar();

        switch (opcao) {
            case 1: cadastrar(); break;
            case 2: listar();    break;
            case 0: printf("Encerrando...\n"); break;
            default: printf("Opcao invalida!\n");
        }
    } while (opcao != 0);

    return 0;
}
